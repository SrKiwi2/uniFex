<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <!-- windowSoftInputMode: sin declararlo, Android elige por su cuenta y en una
             ventana de borde a borde escoge adjustPan, que DESPLAZA la ventana entera para
             dejar a la vista el campo enfocado. Eso movia la barra de menu "fija" y peleaba
             con el arrastre del dedo: el formulario de venta no se podia deslizar. Con
             adjustResize la ventana se encoge y la pagina scrollea como debe. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:windowSoftInputMode="adjustResize"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- La camara es para leer el QR de las credenciales en la puerta (pantalla Escanear).
         No se usa para tomar ni guardar fotos: el lector trabaja sobre el fotograma en vivo.
         `required="false"` a proposito, para que la aplicacion siga instalandose en equipos
         sin camara — el codigo tambien se puede teclear, que es el respaldo cuando el papel
         viene arrugado o da el sol de frente. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
</manifest>
